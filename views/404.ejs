<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="./favicon.png" type="image/x-icon" />
    <title>EGPrices API</title>
    <style>
      * {
        box-sizing: border-box;
        padding: 0;
        margin: 0;
      }

      body {
        background-color: #000;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        color: white;
        font-family: sans-serif;
        font-weight: bolder;
        height: 100dvh;
        gap: 20px;
        font-family: monospace;
        font-weight: bolder;
      }

      h1 {
        font-size: 40px;
        color: #ffd700;
        text-align: center;
        font-family: monospace;
      }

      .pathname {
        color: #ffd700;
        font-weight: bold;
      }

      .icon {
        width: 175px;
        filter: drop-shadow(0 0 70px #ffd700);
      }
    </style>
  </head>
  <body>
    <svg
      class="icon"
      xmlns="http://www.w3.org/2000/svg"
      xmlns:xlink="http://www.w3.org/1999/xlink"
      fill="#ffd700"
      version="1.1"
      id="Filled_Icons"
      x="0px"
      y="0px"
      viewBox="-2.4 -2.4 28.80 28.80"
      enable-background="new 0 0 24 24"
      xml:space="preserve"
      stroke="#ffd700"
    >
      <g id="SVGRepo_iconCarrier">
        <g id="Status-Error-Filled">
          <path
            d="M12,0C5.37,0,0,5.37,0,12s5.37,12,12,12s12-5.37,12-12S18.63,0,12,0z M18.38,16.62l-1.77,1.77L12,13.77l-4.62,4.62 l-1.77-1.77L10.23,12L5.62,7.38l1.77-1.77L12,10.23l4.62-4.62l1.77,1.77L13.77,12L18.38,16.62z"
          />
        </g>
      </g>
    </svg>

    <h1>Fetch Error</h1>
    <p><span class="pathname"><%= pathname %></span> endpoint not exist</p>
  </body>
</html>
